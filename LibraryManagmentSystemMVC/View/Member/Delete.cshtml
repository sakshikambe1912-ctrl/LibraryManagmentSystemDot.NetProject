@model LibraryManagmentSystemMVC.Models.MemberViewModel

@{
    ViewData["Title"] = "Delete Member";
}

<h1>Delete Member</h1>

<div class="alert alert-danger">Are you sure you want to delete this member?</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Phone No</dt>
        <dd class="col-sm-10">@Model.Phoneno</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Issue Date</dt>
        <dd class="col-sm-10">@Model.IssueDate.ToShortDateString()</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
