@model List<AuthorViewModel>

@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add Author</a>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Books</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Name</td>
                <td>@author.Email</td>
                <td>@author.Books</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
