@model LibraryManagmentSystemMVC.Models.BookViewModel

@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<div class="alert alert-danger">Are you sure you want to delete this book?</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@(Model.Author?.Name ?? Model.AuthorId.ToString())</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Published Year</dt>
        <dd class="col-sm-10">@Model.PublishedYear</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Total Copies</dt>
        <dd class="col-sm-10">@Model.TotalCopies</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Available Copies</dt>
        <dd class="col-sm-10">@Model.AvailableCpoies</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
