@model List<BookViewModel>

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add Book</a>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Published Year</th>
            <th>Total Copies</th>
            <th>Available Copies</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@(book.Author?.Name ?? book.AuthorId.ToString())</td>
                <td>@book.PublishedYear</td>
                <td>@book.TotalCopies</td>
                <td>@book.AvailableCpoies</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
