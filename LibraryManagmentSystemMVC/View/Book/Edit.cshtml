@model LibraryManagmentSystemMVC.Models.BookViewModel

@{
    ViewData["Title"] = "Update Book";
}

<h1>Update Book</h1>
<p class="text-muted">The API only allows updating the number of available copies for a book.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Author</dt>
            <dd class="col-sm-8">@(Model.Author?.Name ?? Model.AuthorId.ToString())</dd>

            <dt class="col-sm-4">Published Year</dt>
            <dd class="col-sm-8">@Model.PublishedYear</dd>

            <dt class="col-sm-4">Total Copies</dt>
            <dd class="col-sm-8">@Model.TotalCopies</dd>
        </dl>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="AvailableCpoies" class="form-label">Available Copies</label>
                <input asp-for="AvailableCpoies" type="number" class="form-control" />
                <span asp-validation-for="AvailableCpoies" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
